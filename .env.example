# Copy to .env (gitignored). No keys: auth is DefaultAzureCredential (az login locally, managed identity on Azure).
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
MODEL_FAST=gpt-5-mini
MODEL_STRONG=gpt-5-mini
SPEECH_REGION=<region>
SPEECH_RESOURCE_ID=<resource-id>
# 1 = answer agent calls from data/replays/agent_cache.json (demo with Foundry off)
REPLAY_MODE=0
# 1 = save every good Foundry answer to that cache
RECORD_REPLAY=0
# Public host(s) allowed to reach /mcp, for example <app>.<region>.azurecontainerapps.io
MCP_ALLOWED_HOSTS=
# Model reasoning effort for agent calls: low keeps the Narrator inside the 8 s budget
REASONING_EFFORT=low
